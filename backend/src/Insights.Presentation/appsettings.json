{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "https://keycloak.example.local/realms/alnass",
    "Audience": "alnass-insights-api",
    "RequireHttpsMetadata": true,
    "DisableForLocalDevelopment": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "AppCache": {
    "Provider": "Redis",
    "ConnectionString": "redis:6379",
    "KeyPrefix": "alnass",
    "CommandTimeoutSeconds": 30,
    "RunMigrationsOnStartup": false
  },
  "Sources": {
    "Oracle": {
      "Enabled": true,
      "ConnectionString": "User Id=CHANGE_ME;Password=CHANGE_ME;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=CHANGE_ME)(PORT=1521))(CONNECT_DATA=(SID=CHANGE_ME)));",
      "CommandTimeoutSeconds": 60
    },
    "SqlServerSymbols": {
      "Enabled": true,
      "ConnectionString": "Server=CHANGE_ME,1433;Database=CHANGE_ME;User Id=CHANGE_ME;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;",
      "CommandTimeoutSeconds": 30,
      "SymbolsObject": "meta.v_SymbolCatalog"
    }
  },
  "Synchronization": {
    "Enabled": true,
    "Tier3IntervalMinutes": 360,
    "ActivateFasterTiers": false
  },
  "PublicUrls": {
    "Dashboard": "https://CHANGE_ME.example",
    "ApiBase": "https://CHANGE_ME.example/api/v1"
  },
  "HospitalVm": {
    "IpAddress": "CHANGE_ME",
    "RdpPort": 0
  }
}
