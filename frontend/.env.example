# Copy to frontend/.env (gitignored). Used by Vite (`npm run dev` / local builds).
# Docker image builds use root stack env files (.env.dev / .env.ppr / .env) via compose build.args.
#
# UI always calls the Insights API — no mock data, no alternate backends.
# Never put JWT secrets, SQL passwords, or Oracle credentials in frontend env files.

# API base path/URL consumed by src/infrastructure/api/config.ts
# Prefer relative path so the same build works behind frontend-nginx (/api → backend).
VITE_API_BASE_URL=/api/v1

# Absolute API URL only when the UI is hosted on a different origin than the API
# (requires backend Cors:AllowedOrigins / CORS_ALLOWED_ORIGINS to include this UI origin):
# VITE_API_BASE_URL=http://localhost:5080/api/v1

# Public site URL (informational / future absolute links)
VITE_DASHBOARD_PUBLIC_URL=http://localhost:8080

# Vite-only: where the dev server proxies /api, /health, /openapi, /scalar
# (must point at Insights.Presentation — default matches launchSettings.json)
VITE_DEV_PROXY_TARGET=http://localhost:5080
