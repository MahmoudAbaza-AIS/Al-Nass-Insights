# Environment files (gitignored — copy and fill secrets locally / on the deploy host):
#
#   .env.dev   → Development stack  (alnass-dev-*)
#   .env.ppr   → Pre-production stack (alnass-ppr-*)
#   .env       → Production stack   (alnass-prod-*)
#
# Backend appsettings:
#   backend/src/Insights.Presentation/appsettings.json  ← committed template (no secrets)
#   appsettings.Development.json | appsettings.ppr.json | appsettings.Production.json
#   → gitignored when they contain secrets; prefer Docker env vars for runtime secrets.
#
# How Compose reads configuration (important):
#   - `docker compose --env-file .env.dev ...` substitutes ${VARS} in docker-compose.yml
#     (project name, ports, image names, and the backend `environment:` mappings).
#   - The backend service ALSO loads STACK_ENV_FILE via Compose `env_file:` for any
#     additional keys. Passing --env-file alone does NOT inject every variable into
#     every container — only what compose.yml maps or lists under env_file.
#
# Local:
#   docker compose --env-file .env.dev up -d --build   # UI http://localhost:8080
#   docker compose --env-file .env.ppr up -d --build   # UI http://localhost:8081
#   docker compose --env-file .env     up -d --build   # UI http://localhost:80
#   .\scripts\docker-up.ps1 -Stack dev -Build
#
# CI/CD deploy (images already built/pushed — do not --build on the server):
#   BACKEND_IMAGE / FRONTEND_IMAGE are set by Deploy-ComposeStack.ps1
#
# Each stack containers:
#   alnass-{dev|ppr|prod}-frontend-nginx
#   alnass-{dev|ppr|prod}-backend
#   alnass-{dev|ppr|prod}-redis
#   alnass-{dev|ppr|prod}-sql
#
# Oracle is customer-managed (external). This repo never provisions Oracle.

# --- Stack identity (required for compose isolation) ---
COMPOSE_PROJECT_NAME=alnass-prod
STACK_NAME=prod
STACK_ENV_FILE=.env
UI_HOST_PORT=80

# --- Image references (optional locally; required for CI pull-based deploy) ---
# Leave as local tags when using `docker compose up --build`.
BACKEND_IMAGE=alnass-backend:local
FRONTEND_IMAGE=alnass-frontend:local
# missing = use local/build; always = pull from registry (CI deploy)
PULL_POLICY=missing

ASPNETCORE_ENVIRONMENT=Production

# KPI / sync app cache — Redis service hostname inside the stack network
APPCACHE_PROVIDER=Redis
APPCACHE_CONNECTION_STRING=redis:6379
APPCACHE_KEY_PREFIX=alnass
# Only applies when APPCACHE_PROVIDER=SqlServer. Redis skips SQL migrations.
APPCACHE_RUN_MIGRATIONS_ON_STARTUP=false

# Application-owned SQL Server (symbols / widget catalog) — not customer Oracle
MSSQL_SA_PASSWORD=CHANGE_ME

# Customer Oracle (external — hospital-managed). Enable only when reachable.
ORACLE_ENABLED=true
ORACLE_CONNECTION_STRING=User Id=readonly_user;Password=CHANGE_ME;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=CHANGE_ME)(PORT=1521))(CONNECT_DATA=(SID=CHANGE_ME)));

SYMBOLS_ENABLED=true
SYMBOLS_CONNECTION_STRING=Server=sql,1433;Database=CHANGE_ME;User Id=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;
SYMBOLS_OBJECT=meta.v_SymbolCatalog

SYNC_ENABLED=true
SYNC_TIER3_INTERVAL_MINUTES=360
SYNC_ACTIVATE_FASTER_TIERS=false

# LocalJwt issues tokens via POST /api/v1/auth/login (users in auth.Users).
# Set Mode=Keycloak to validate external IdP tokens instead.
AUTH_MODE=LocalJwt
AUTH_ISSUER=alnass-insights
AUTH_AUDIENCE=alnass-insights-api
AUTH_JWT_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_TOKEN_LIFETIME_MINUTES=480
AUTH_DISABLE_FOR_LOCAL_DEVELOPMENT=false
OPENAPI_ENABLED=false
AUTH_AUTHORITY=https://keycloak.example.local/realms/alnass
AUTH_REQUIRE_HTTPS_METADATA=true
SYMBOLS_RUN_MIGRATIONS_ON_STARTUP=true

DASHBOARD_PUBLIC_URL=https://dashboard.alnaseg.dynv6.net
API_PUBLIC_BASE_URL=https://dashboard.alnaseg.dynv6.net/api/v1

# Frontend build-time — baked into the frontend-nginx image at `docker build`
# STACK_NAME (above) also selects frontend/nginx/nginx.{dev|ppr|prod}.conf
# Prefer relative API base so one image works behind the stack nginx proxy.
VITE_API_BASE_URL=/api/v1
VITE_DASHBOARD_PUBLIC_URL=https://dashboard.alnaseg.dynv6.net
